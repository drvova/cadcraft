+use slab_compile::{Options, compile, raster::Raster, svg::render_svg};
+use slab_kernel::frame;
+use slab_slir::Slir;
+
+const SOURCE: &str = r#"col w=140 h=48 {
+  text "AB" family="Test Face" size=24
+}"#;
+
+fn fixture(client: u32) -> (Slir, frame::Instance) {
+	let (slir, diagnostics) =
+		compile(SOURCE, &Options { embed_assets: false, ..Options::default() });
+	assert!(diagnostics.is_empty(), "a fontless compile is as quiet as any: {:#?}", diagnostics.0);
+	let slir = slir.expect("valid source");
+	let bytes = slab_slir::write(&slir);
+	let (mut instance, _) = slab_slir::instance(&bytes).expect("decode fixture");
+	frame::inst_set_env(&mut instance, 140.0, 48.0, client, false, false);
+	(slir, instance)
+}
+
+fn register(instance: &mut frame::Instance, face: &[u8], data: &[u8]) {
+	let metrics = slab_fonts::parse_metrics(face).expect("the face parses");
+	frame::inst_font_register(
+		instance,
+		"Test Face",
+		u32::from(metrics.weight),
+		u32::from(metrics.upem),
+		i32::from(metrics.ascent),
+		i32::from(metrics.descent),
+		i32::from(metrics.line_gap),
+		i32::from(metrics.underline_position),
+		i32::from(metrics.underline_thickness),
+		u32::from(metrics.default_advance),
+		data,
+		&metrics.cps,
+		&metrics.gids,
+		&metrics.advances,
+	);
+}
+
+/// A face read from disk at run time: nothing of it is compiled in.
+fn face_on_disk() -> Vec<u8> {
+	std::fs::read(concat!(
+		env!("CARGO_MANIFEST_DIR"),
+		"/../../assets/fonts/JetBrainsMono-Regular.ttf"
+	))
+	.expect("the repository's fallback face is on disk")
+}
+
+#[test]
+fn a_family_laid_out_with_default_advances_is_named_once_until_registered() {
+	let (slir, mut instance) = fixture(3);
+	for table in &slir.fonts {
+		assert!(table.data.is_empty(), "a fontless compile embeds no face");
+		assert_eq!(table.upem, slab_fonts::DEFAULT_UPEM);
+		assert_eq!(table.cmap.len(), table.advances.len());
+	}
+	let first = frame::inst_frame(&mut instance, 0.0);
+	let named: Vec<_> = first
+		.diagnostics
+		.iter()
+		.filter(|diagnostic| diagnostic.code == "font-default")
+		.collect();
+	assert_eq!(named.len(), 1, "{:#?}", first.diagnostics);
+	assert!(named[0].msg.contains("family 'Test Face'"), "{named:#?}");
+	assert_eq!(named[0].line, 2);
+	// "AB" at 24 units: two capitals of the default table, 660/1000 em
+	// each: 31.68 units.
+	let width = first
+		.ops
+		.iter()
+		.find_map(|op| match op {
+			slab_kernel::flatten::FrameOp::Text(text) => Some(text.measured_w),
+			_ => None,
+		})
+		.expect("the fixture paints one text op");
+	assert!((width - 31.68).abs() < 1e-6, "{width}");
+
+	// Metrics alone (no bytes) make the host the owner of the face: a fresh
+	// instance that registers them first is never told about the family.
+	let (_, mut registered) = fixture(3);
+	register(&mut registered, &face_on_disk(), &[]);
+	let frame = frame::inst_frame(&mut registered, 0.0);
+	assert!(
+		frame
+			.diagnostics
+			.iter()
+			.all(|diagnostic| diagnostic.code != "font-default"),
+		"{:#?}",
+		frame.diagnostics
+	);
+}
+
+#[test]
+fn svg_needs_only_metrics() {
+	let (slir, mut instance) = fixture(3);
+	let rendered = frame::inst_frame_static(&mut instance);
+	let svg = render_svg(&slir, instance.doc(), &[], &[], &[], &rendered, std::path::Path::new("."));
+	assert!(svg.contains(">AB</text>"), "{svg}");
+	assert!(svg.contains("font-family=\"Test Face, "), "{svg}");
+	assert!(!svg.contains("@font-face"), "no face exists to embed: {svg}");
+}
+
+#[test]
+fn raster_refuses_without_outlines_and_paints_with_a_registered_face() {
+	let (slir, mut instance) = fixture(4);
+	let rendered = frame::inst_frame(&mut instance, 0.0);
+	let Err(error) = Raster::new(&slir, instance.doc(), &[], &[], &[], 1.0).render(&rendered) else {
+		panic!("text with no outlines must be refused");
+	};
+	assert!(error.contains("family 'Test Face'"), "{error}");
+	assert!(error.contains("bundles no fonts"), "{error}");
+
+	let face = face_on_disk();
+	register(&mut instance, &face, &face);
+	let rendered = frame::inst_frame(&mut instance, 0.0);
+	let pixmap = Raster::new(&slir, instance.doc(), &[], &[], &[], 1.0)
+		.render(&rendered)
+		.expect("a registered face has outlines");
+	let ink = pixmap
+		.pixels()
+		.iter()
+		.filter(|pixel| pixel.alpha() > 0)
+		.count();
+	assert!(ink > 0, "the registered face paints glyph ink");
+}
