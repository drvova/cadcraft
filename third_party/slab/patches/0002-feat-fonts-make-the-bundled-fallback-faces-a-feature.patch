+		'i' | 'l' | 'j' | 'I' | '.' | ',' | ':' | ';' | '!' | '|' | '\'' | '`' => 280,
+		'\u{b7}' | '\u{2018}' | '\u{2019}' => 280,
+		'f' | 't' | 'r' | '(' | ')' | '[' | ']' | '{' | '}' | '/' | '\\' | '-' | '"' | '*' => 360,
+		'\u{b0}' | '\u{201c}' | '\u{201d}' => 360,
+		'm' | 'w' | 'M' | 'W' | '@' | '%' | '&' | '\u{2014}' | '\u{2026}' | '\u{2030}' => 860,
+		'0'..='9' => 600,
+		_ if ch.is_lowercase() => 540,
+		_ if ch.is_uppercase() => 660,
+		_ => 600,
