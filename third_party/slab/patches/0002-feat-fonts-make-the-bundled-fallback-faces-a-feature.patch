+			advances.push(u32::from(default_advance(class, cp)));
+		}
+	}
+	RegisteredMetrics {
+		weight,
+		upem: DEFAULT_UPEM,
+		ascent: 960,
+		descent: -240,
+		line_gap: 0,
+		default_advance: 600,
+		underline_position: -100,
+		underline_thickness: 50,
+		cps,
+		gids,
+		advances,
+	}
