+/// strokes (`i l j I . , : ; ! | '`) 280, the narrow letters and brackets
+/// (`f t r ( ) [ ] { } / \ - " *`) 360, lowercase 540, numerals and anything
+/// unclassed 600, capitals 660, the wide letters and signs (`m w M W @ % &`,
+/// the em dash, the ellipsis) 860. Text measured with it wraps and aligns
+/// sensibly in any ordinary sans-serif; it is exact for none.
+pub const fn default_advance(class: u8, codepoint: u32) -> u16 {
+	if class == CLASS_MONO {
+		return 600;
+	}
+	let Some(ch) = char::from_u32(codepoint) else {
+		return 600;
+	};
+	match ch {
