+/// Names the first FONT table `frame` sets text in that has no glyph outlines.
+///
+/// Such a table has neither embedded bytes, nor a registered face, nor a
+/// bundled asset: only a build without bundled fonts can have one. An exporter
+/// that draws outlines (PNG, APNG) returns this as its error rather than a
+/// picture with the text missing; exporters that need metrics only (SVG,
+/// terminal cells) never ask.
+pub fn missing_face(
+	doc: &Doc,
+	frame: &slab_kernel::flatten::Frame,
+	registered: &[RegisteredFont],
+) -> Option<String> {
+	let mut seen = std::collections::BTreeSet::new();
+	for glyph in &frame.glyphs {
+		let Ok(font) = usize::try_from(glyph.font) else {
+			continue;
+		};
+		if !seen.insert(font) || face_bytes(doc, font, registered).is_some() {
+			continue;
+		}
+		let (Some(&family), Some(&weight)) = (doc.font_family.get(font), doc.font_weight.get(font))
+		else {
+			continue;
+		};
+		let family = doc.strs.get(family as usize).map_or("", String::as_str);
+		let shown = if family.is_empty() {
+			"the default family".to_owned()
+		} else {
+			format!("family '{family}'")
+		};
+		return Some(format!(
+			"no glyph outlines for {shown} (weight {weight}): this build bundles no fonts, so a \
+			 raster export needs the face's bytes registered with the host; an SVG export needs none"
+		));
+	}
+	None
 }
 
