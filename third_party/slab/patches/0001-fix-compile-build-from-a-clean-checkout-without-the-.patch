diff --git a/crates/slab-compile/build.rs b/crates/slab-compile/build.rs
index 2f5d23f..0de060d 100644
--- a/crates/slab-compile/build.rs
+++ b/crates/slab-compile/build.rs
@@ -1,20 +1,76 @@
 //! Embeds the git commit hash so every front end (`slab --version`,
 //! `slab-native --version`, the WASM `compiler_version` export) can pin a
-//! build. Falls back to `unknown` outside a git checkout.
+//! build, and decides whether the `gen wc` payload can be embedded.
+//!
+//! The hash is `SLAB_GIT_HASH` from the environment when a packager sets it,
+//! else the short `HEAD` of the checkout this crate belongs to, else
+//! `unknown`. A copy of the crate nested inside another repository (vendored,
+//! or fetched into a build directory) reports `unknown` rather than that
+//! repository's hash.
+//!
+//! The payload (the bundled web runtime and the kernel's wasm) is two untracked
+//! build products of `just web-runtime`. With the `wc-embed` feature they are
+//! embedded when both exist (`cfg(slab_wc_payload)`); when either is missing
+//! the crate still builds, with a warning, and `gen wc` says what to run.
 
-use std::process::Command;
+use std::{
+	path::{Path, PathBuf},
+	process::Command,
+};
 
-fn main() {
-	let hash = Command::new("git")
-		.args(["rev-parse", "--short=9", "HEAD"])
+fn git(dir: &Path, args: &[&str]) -> Option<String> {
+	Command::new("git")
+		.current_dir(dir)
+		.args(args)
 		.output()
 		.ok()
 		.filter(|out| out.status.success())
 		.and_then(|out| String::from_utf8(out.stdout).ok())
 		.map(|s| s.trim().to_owned())
 		.filter(|s| !s.is_empty())
+}
+
+/// The short hash of the checkout whose root is the workspace this crate sits
+/// in (`crates/slab-compile` two levels below it).
+fn checkout_hash(manifest_dir: &Path) -> Option<String> {
+	let root = manifest_dir.parent()?.parent()?.canonicalize().ok()?;
+	let top = PathBuf::from(git(manifest_dir, &["rev-parse", "--show-toplevel"])?)
+		.canonicalize()
+		.ok()?;
+	(top == root)
+		.then(|| git(manifest_dir, &["rev-parse", "--short=9", "HEAD"]))
+		.flatten()
+}
+
+fn main() {
+	let manifest_dir = PathBuf::from(std::env::var("CARGO_MANIFEST_DIR").unwrap_or_default());
+
+	println!("cargo:rerun-if-env-changed=SLAB_GIT_HASH");
+	let hash = std::env::var("SLAB_GIT_HASH")
+		.ok()
+		.map(|s| s.trim().to_owned())
+		.filter(|s| !s.is_empty() && s.chars().all(|c| c.is_ascii_alphanumeric()))
+		.or_else(|| checkout_hash(&manifest_dir))
 		.unwrap_or_else(|| "unknown".to_owned());
 	println!("cargo:rustc-env=SLAB_GIT_HASH={hash}");
 	// Re-embed when HEAD moves (best effort; .git may be absent in tarballs).
 	println!("cargo:rerun-if-changed=../../.git/HEAD");
+
+	println!("cargo:rustc-check-cfg=cfg(slab_wc_payload)");
+	let payload =
+		["../../gen/web-runtime/slab-runtime.js", "../../clients/web/wasm/slab_kernel_bg.wasm"];
+	for file in payload {
+		println!("cargo:rerun-if-changed={file}");
+	}
+	if std::env::var_os("CARGO_FEATURE_WC_EMBED").is_some() {
+		if payload.iter().all(|file| manifest_dir.join(file).is_file()) {
+			println!("cargo:rustc-cfg=slab_wc_payload");
+		} else {
+			println!(
+				"cargo:warning=slab-compile: the web runtime payload is not built (run `just \
+				 web-runtime`), so this build's `gen wc` cannot write slab-runtime.js or the kernel \
+				 wasm"
+			);
+		}
+	}
 }
