From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CADCraft <noreply@cadcraft.invalid>
Date: Thu, 12 Nov 2026 22:47:41 +0000
Subject: [PATCH 3/4] feat(web): register a face by its metrics, painted by the
 page

`SlabElement.registerFont(name, bytes)` needs a font file. A page that paints
with a face it already owns (its system UI stack, say) has no bytes to give,
and should not have to load a second face to be measured correctly.

`SlabElement.registerFontMetrics(name, metrics, cssFamily)` registers a
metrics-only runtime face: the kernel measures with `metrics` and the driver
paints with `cssFamily`, a CSS `font-family` value the host owns. No font
bytes cross the boundary and nothing is added to `document.fonts`. A family
registered this way is the host's: the driver neither copies a fallback face
out of the kernel for it nor loads one. `FontMetrics` is exported.
---
 clients/web/element.ts | 36 ++++++++++++++++++++++++++++++++++++
 clients/web/index.ts   |  1 +
 2 files changed, 37 insertions(+)

diff --git a/clients/web/element.ts b/clients/web/element.ts
index 84b9dde..031346f 100644
--- a/clients/web/element.ts
+++ b/clients/web/element.ts
@@ -860,6 +860,13 @@ export class SlabElement extends HTMLElement {
          const ascent = statics.font_ascent[index];
          const descent = statics.font_descent[index];
          let family: string;
+         // A metrics-only registration owns this family: the host paints it,
+         // so the bundled fallback face is neither copied out nor loaded.
+         const hostOwned = nearestRegisteredFace(named, statics.font_weight[index]);
+         if (hostOwned && hostOwned.bytes.length === 0) {
+            fonts.push({ family: hostOwned.cssFamily, upem, ascent, descent });
+            continue;
+         }
          const embedded = inst.font_data(index);
          if (embedded.length > 0 && typeof FontFace === 'function') {
             const cssFamily = `slab-f${fontSeq++}`;
@@ -976,6 +983,35 @@ export class SlabElement extends HTMLElement {
       return true;
    }
 
+   /**
+    * Register a metrics-only runtime face: the kernel measures with `metrics`
+    * and the host paints with `cssFamily`, a serialized CSS `font-family`
+    * value it already owns (the page's system UI stack, say). No font bytes
+    * cross the boundary: nothing is fetched, parsed or added to
+    * `document.fonts`. Registering the same family and weight again replaces
+    * the metrics on every mounted element.
+    */
+   static registerFontMetrics(name: string, metrics: FontMetrics, cssFamily: string): boolean {
+      if (!(metrics.upem > 0) || cssFamily === '') return false;
+      if (metrics.cps.length !== metrics.advs.length || metrics.cps.length !== metrics.gids.length)
+         return false;
+      const key = `${fontKey(name)}\u0000${metrics.weight}`;
+      fontSeq++;
+      const face: RegisteredFace = {
+         family: name,
+         bytes: new Uint8Array(0),
+         metrics,
+         cssFamily,
+         seq: fontSeq,
+      };
+      registeredFaces.set(key, face);
+      for (const element of mountedElements) {
+         element.#appliedFonts.delete(key);
+         element.#applyFont(key, face);
+      }
+      return true;
+   }
+
    // -------------------------------------------------------------------- env
 
    #measure(): void {
diff --git a/clients/web/index.ts b/clients/web/index.ts
index 3b0b567..c62ae76 100644
--- a/clients/web/index.ts
+++ b/clients/web/index.ts
@@ -24,5 +24,6 @@ export type {
    SignalDef,
    Statics,
 } from './kernel.ts';
+export type { FontMetrics } from './fontmetrics.ts';
 export { itemKey } from './keys.ts';
 export { type FontCss, gradientCss, Painter, rgbaCss } from './painter.ts';
