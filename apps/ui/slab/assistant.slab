  path "M4 5h2v2H4z M4 11h2v2H4z M4 17h2v2H4z M9 6h11 M9 12h11 M9 18h11" bg=none stroke=current stroke-w=2.5
}
icon a-gem-sm viewbox=24 {
  path "M7.5 5.25h9l4.5 4.5-9 10.5-9-10.5z M3 9.75h18 M9 9.75l3 10.5 M15 9.75l-3 10.5" bg=none stroke=current stroke-w=2.5
}
// ---- end of the generated glyphs ----

// One open chat, as a tab with its close key. `shut` is the close key's name; `cap` the widest
// the tab may be (18 characters of the page's face: ui.css, `.ui-tab--sm`). The room between two
// chats is before each one but the first (`lead`).
def AssistantChat(name="", shut="", front=false, lead=true, cap=200) export {
  row align=center {
    when lead { pad-l=space.g2 }
    row h=size.control-h-row max-w=cap pad=0,space.g6 align=center radius=radius.card color=color.text-faint \
        role=tab label=name selected=front act=chat {
      when coarse { h=size.control-h-input min-w=size.control-h-input pack=center }
      when hover { bg=color.hover color=color.text }
      when front { bg=color.fill-active color=color.text }
      when focus-visible { stroke=color.focus-ring stroke-w=1 stroke-align=inside }
      text name style=text.label nowrap ellipsis inert
    }
    row #shut w=size.control-h-chip h=size.control-h-chip radius=radius.round align=center pack=center \
        color=color.icon role=button label=shut act=chat_shut {
      when coarse { w=size.control-h-input h=size.control-h-input }
      when hover { bg=color.hover color=color.text }
      when pressed { bg=color.fill-active color=color.text }
      when focus-visible { stroke=color.focus-ring stroke-w=1 stroke-align=inside }
      icon a-close-sm size=size.icon-size-sm inert
    }
  }
}

// One suggestion of the empty state: a press puts its words in the composer.
def AssistantIdea(words="", glyph="") export {
  row w=fill h=size.control-h-row pad=0,space.g4 align=center radius=radius.card \
      role=button label=words act=suggest {
    when coarse { h=size.control-h-input }
    when hover { bg=color.hover }
    when pressed { bg=color.fill-active }
    when focus-visible { stroke=color.focus-ring stroke-w=1 stroke-align=inside }
    icon glyph size=size.icon-size-md color=color.icon inert
    rect w=space.g8 h=size.hairline
    row w=fill h=fill align=center {
      text words style=text.body color=color.text nowrap ellipsis inert
    }
    icon a-chevron-right-sm size=size.icon-size-sm color=color.text-disabled inert
  }
}

// One thing the message carries: the canvas selection or something pointed at with `@` (`tinted`:
// context, in the accent), or a picture (`pictured`: its thumbnail is the image the host
// registered under `thumb`). `shut` names the key that takes it out; `cap` is the widest the name is.
def AssistantChip(name="", shut="", glyph="", thumb="", tinted=false, pictured=false, lead=false, cap=120) export {
  row {
    when lead { pad-l=space.g4 }
    row pad=space.g3,assist.chip-inset gap=space.g4 align=center radius=radius.small bg=color.control {
      when !tinted { stroke=color.border-soft stroke-w=assist.edge }
      when tinted { bg=color.accent-soft }
      row #face align=center {
        when pictured { img thumb w=assist.thumb h=assist.thumb fit=cover radius=radius.control }
        when !pictured {
          icon glyph size=size.icon-size-sm color=color.icon {
            when tinted { color=color.text-accent }
          }
        }
      }
      row h=fill max-w=cap align=center {
        text name style=text.chip color=color.text-dim nowrap ellipsis {
          when tinted { color=color.text-accent }
        }
      }
      row #drop w=size.control-h-chip h=size.control-h-chip radius=radius.round align=center pack=center \
          color=color.icon role=button label=shut act=chip_shut {
        when coarse { w=size.control-h-input h=size.control-h-input }
        when hover { bg=color.hover color=color.text }
        when pressed { bg=color.fill-active color=color.text }
        when focus-visible { stroke=color.focus-ring stroke-w=1 stroke-align=inside }
        icon a-close-sm size=size.icon-size-sm inert
      }
    }
  }
}

// One line of the chips. The host breaks them into lines (assistant-params.ts): an `each` under
// a `wrap` is one box to the wrap at this commit.
def AssistantChipLine(lead=false, chips=list(AssistantChip)) export {
  row w=fill {
    when lead { pad-t=space.g4 }
    each chips
  }
}

params {
  // The band's words: the panel's name (quiet), or the task in hand while a model is set up.
  title text = "Assistant"
  quiet bool = true
  // More than one chat: the band holds them as tabs.
  tabbed bool = false
  chats list(AssistantChat) = []
  // A model is being set up: the sheet (in the `main` hole) has the panel to its foot.
  setup bool = false
  // The chat has no rows: the empty state stands on the composer.
  blank bool = false
  line text = ""
  // A model is set up: the suggestions follow the line.
  suggest bool = false
  ideas list(AssistantIdea) = []
  // The heights of what the host mounts over the card and in it (a hole reports no shrinking).
  stack_h num = 0
  editor_h num = 20
  // The keyboard is in the editor: the card's hairline steps up.
  typing bool = false
  chipped bool = false
  chip_lines list(AssistantChipLine) = []
  // The model slot: the model's name, or the call to set one up (`unset`); what a press does;
  // the widest the slot may be beside the keys.
  model text = "Set up a model"
  model_said text = ""
  model_cap num = 200
  unset bool = true
  // The context meter: its figures, what they are, and whether the line has room for them.
  meter text = ""
  meter_said text = ""
  metered bool = false
  // The send key: Send or Queue, or (a turn runs and nothing is typed) the key that stops it.
  stopping bool = false
  send_name text = "Send"
  send_said text = ""
  send_off bool = true
}

col #panel w=fill h=fill bg=color.panel {
  row #head w=fill h=assist.head pad=0,assist.head-end,0,assist.inset gap=space.g6 align=center {
    row #name w=fill h=fill align=center {
      when !tabbed {
        text param.title style=text.body color=color.text nowrap ellipsis {
          when quiet { color=color.text-dim }
        }
      }
      when tabbed {
        row #tabs w=fill h=fill align=center scroll role=tablist label="Chats" {
          each param.chats
        }
      }
    }
    row #keys align=center {
      row #new w=size.control-h-input h=size.control-h-input radius=radius.round align=center pack=center \
          color=color.icon role=button label="New chat" act=new_chat {
        when hover { bg=color.hover color=color.text }
        when pressed { bg=color.fill-active color=color.text }
        when focus-visible { stroke=color.focus-ring stroke-w=1 stroke-align=inside }
        icon a-plus-md size=size.icon-size-md inert
      }
      row #close w=size.control-h-input h=size.control-h-input radius=radius.round align=center pack=center \
          color=color.icon role=button label="Close the assistant" act=close {
        when hover { bg=color.hover color=color.text }
        when pressed { bg=color.fill-active color=color.text }
        when focus-visible { stroke=color.focus-ring stroke-w=1 stroke-align=inside }
        icon a-close-md size=size.icon-size-md inert
      }
    }
  }
  rect #edge w=fill h=size.hairline bg=color.border
  // The conversation, and the setup sheet over it. The empty state stands under it, on the
  // composer (a `when`'s children come after the node's own).
  col #main w=fill h=fill {
    hole main w=fill h=fill
    when blank {
      col #empty w=fill pad=0,0,space.g12,0 {
        row w=fill pad=0,assist.inset {
          text param.line style=text.body leading=assist.leading color=color.text-faint w=fill
        }
        when suggest {
          col #ideas w=fill pad=space.g8,assist.ideas,0,assist.ideas {
            each param.ideas
          }
        }
      }
    }
  }
  col #footbox w=fill {
    when !setup {
      rect #seam w=fill h=size.hairline bg=color.border
      col #foot w=fill pad=space.g8 {
        hole stack w=fill h=param.stack_h
        col #card w=fill pad=assist.edge radius=assist.radius bg=color.surface-elevated \
            stroke=color.composer-border stroke-w=assist.edge {
          when typing { stroke=color.composer-border-active }
          col #chipbox w=fill {
            when chipped {
              col #chips w=fill pad=space.g8,space.g12,0,space.g12 {
                each param.chip_lines
              }
            }
          }
          row #words w=fill pad=space.g8,space.g12,space.g4,space.g12 {
            hole editor w=fill h=param.editor_h
          }
          row #tools w=fill h=assist.tools pad=space.g6,space.g6,space.g6,space.g4 gap=space.g4 align=center {
            row #model h=size.control-h-input max-w=param.model_cap pad=0,space.g8 gap=space.g2 align=center \
                radius=radius.round color=color.text-dim role=button label=param.model desc=param.model_said \
                expanded=param.setup act=model {
              when unset { color=color.text-accent }
              when hover { bg=color.hover }
              when pressed { bg=color.fill-active }
              when focus-visible { stroke=color.focus-ring stroke-w=1 stroke-align=inside }
              text param.model style=text.body nowrap ellipsis inert
              when !unset { icon a-chevron-down-sm size=size.icon-size-sm inert }
            }
            spacer
            row #meterbox align=center {
              when metered {
                text param.meter style=text.mono color=color.text-faint nowrap role=img label=param.meter_said
                rect w=space.g4 h=size.hairline
              }
            }
            row #attach w=size.control-h-input h=size.control-h-input radius=radius.round align=center pack=center \
                color=color.icon role=button label="Attach a picture" desc="Or paste one, or drop one on the panel" act=attach {
              when hover { bg=color.hover color=color.text }
              when pressed { bg=color.fill-active color=color.text }
              when focus-visible { stroke=color.focus-ring stroke-w=1 stroke-align=inside }
              icon a-attach-md size=size.icon-size-md inert
            }
            row #send w=size.control-h-input h=size.control-h-input radius=radius.round align=center pack=center \
                bg=color.text color=color.on-accent role=button label=param.send_name desc=param.send_said act=send {
              when hover { bg=color.text-dim }
              when pressed { bg=color.text-faint }
              when send_off { bg=color.fill-disabled color=color.text-disabled }
              when focus-visible { stroke=color.focus-ring stroke-w=2 }
              when !stopping { icon a-send-md size=size.icon-size-md inert }
              when stopping { icon a-stop-md size=size.icon-size-md inert }
            }
          }
        }
      }
    }
  }
}
