// The assistant panel's frame: the title band (the panel's name, or the open chats as tabs, and
// the keys that open a chat and close the panel), the empty state, and the composer's card (the
// chips a message carries, the toolbar: the model slot, the context meter, attach, send or stop).
// The view only: every word, which parts show and where a chip's line breaks is shaped in
// TypeScript (src/slab/assistant-params.ts) from the SolidJS panel's own state
// (src/components/AssistantPane.tsx: `AssistantFrame`), and every press comes back as a signal.
//
// What stays the interface's own, in holes: the conversation and the setup sheet over it (`main`),
// what stands over the card (`stack`: the queue, the changes, the status, the slash and `@`
// lists), and the editor (`editor`: a native text area). src/slab/SlabAssistant.tsx says why.
//
// Under a finger (`when coarse`) the small keys and the rows are the 24 of a target (ui.css,
// `pointer: coarse`). The SolidJS small key keeps its 20 and takes the rest as an overhang the
// eye does not see; a Slab node has no overhang, so here the key itself is 24 and a chip is 4 taller.
//
// Measures follow src/assistant.css (.assistant-head, .assistant-empty, .assistant-composer,
// .assistant-box, .assistant-attachment, .assistant-row, .assistant-ghost) and src/ui/ui.css
// (.ui-icon-button, .ui-tab--sm, .ui-row).
//
// A box with children never carries a stroke the web driver paints as a CSS border (see
// slab/objects.slab): the card's hairline and every focus ring are centred strokes.
import "gen/tokens.slab"

tokens {
  assist {
    // The title band, the column every line of text in the panel starts on (the gutter, a card's
    // hairline and its inset), and the band's right inset (the gutter, the hairline, the toolbar's 6).
    head 35; inset 21; head-end 15
    // A card's corner (the block corner less one step) and its hairline.
    radius 10; edge 1
    // The suggestions step out of the text column by a row's own inset.
    ideas 17
    // Prose that is read: the 20px line of the 13px type.
    leading 1.5385
    // The toolbar's line, a picture's thumbnail, the widest a chip's name is.
    tools 36; thumb 20
    // A chip's inset at its sides: its own 4 and the hairline the SolidJS chip is boxed by.
    chip-inset 5
  }
}

// ---- glyphs: generated from src/icons.ts by src/slab/assistant-icons.ts; do not edit ----
icon a-plus-md viewbox=24 {
  path "M12 5v14 M5 12h14" bg=none stroke=current stroke-w=2.1429
}
icon a-close-md viewbox=24 {
  path "M6 6l12 12 M18 6L6 18" bg=none stroke=current stroke-w=2.1429
}
icon a-attach-md viewbox=24 {
  path "M21 11l-9 9a5 5 0 0 1-7-7l8-8a3.5 3.5 0 0 1 5 5l-8 8a2 2 0 0 1-3-3l7-7" bg=none stroke=current stroke-w=2.1429
}
icon a-send-md viewbox=24 {
  path "M12 19V5 M6 11l6-6 6 6" bg=none stroke=current stroke-w=2.1429
}
icon a-stop-md viewbox=24 {
  path "M7 7h10v10H7z" bg=none stroke=current stroke-w=2.1429
}
icon a-ring-md viewbox=24 {
  path "M12 7.5a6.5 6.5 0 1 0 0 13a6.5 6.5 0 1 0 0-13 M12 2.5l3 2.5-3 2.5-3-2.5z" bg=none stroke=current stroke-w=2.1429
}
icon a-gem-md viewbox=24 {
  path "M7.5 5.25h9l4.5 4.5-9 10.5-9-10.5z M3 9.75h18 M9 9.75l3 10.5 M15 9.75l-3 10.5" bg=none stroke=current stroke-w=2.1429
}
icon a-dist-md viewbox=24 {
  path "M3 17L17 3l4 4L7 21z M8 12l2 2 M11 9l2 2 M14 6l2 2" bg=none stroke=current stroke-w=2.1429
}
icon a-chevron-right-sm viewbox=24 {
  path "M9 6l6 6-6 6" bg=none stroke=current stroke-w=2.5
}
icon a-close-sm viewbox=24 {
  path "M6 6l12 12 M18 6L6 18" bg=none stroke=current stroke-w=2.5
}
icon a-chevron-down-sm viewbox=24 {
  path "M6 9l6 6 6-6" bg=none stroke=current stroke-w=2.5
}
icon a-pick-sm viewbox=24 {
  path "M5 3l14 8-6.5 1.8L10 19z" bg=none stroke=current stroke-w=2.5
}
