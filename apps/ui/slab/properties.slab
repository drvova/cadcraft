// The Properties section of the sidebar: the engine's `properties` rows for the selection (or the
// drawing's defaults with nothing selected), each read or edited in place: a typed value, a tick,
// or a choice whose values open as a popup over the panel.
//
// The view only. Every string and every boolean is shaped in TypeScript (src/props.ts,
// src/slab/properties-params.ts); every press, tick and typed value comes back as a signal and
// goes through the same row logic as the SolidJS panel (src/props-edit.ts). The popup of a choice
// is not drawn here: a surface paints inside its own box, and a list of twenty-four lineweights
// under the last section of the rail has no room there. The host draws it (src/slab/popup.tsx),
// anchored to the row's `#choice`.
//
// Measures follow src/interaction.css (.properties-head, .prop-row, .prop-value, .prop-readonly)
// and slab/piece.slab, so the two sections read as one table: the heading is 24 high, a row 22,
// a label starts on the rail's text column (24 in), a value ends 24 before the edge and a
// choice's arrow stands in the 16 after it.
import "gen/tokens.slab"

icon chevron viewbox=24 {
  path "M6 9l6 6 6-6" bg=none stroke=current stroke-w=2.5
}

icon mark viewbox=24 {
  path "M5 12.5l4.5 4.5 9.5-10" bg=none stroke=current stroke-w=3
}

icon dash viewbox=24 {
  path "M5 12h14" bg=none stroke=current stroke-w=3
}

// One property: its label and the control its kind of value takes. `shown` is the value as it
// reads (the text a typed field starts from); `said` is a choice as a screen reader is told it
// ("Layer: 0": a row scrolled out of sight has no text of its own in the tree) and `told` a row
// that is only read ("Type: Line"; empty on a row with a control, which names itself); `hint` is the
// refusal standing on the row, in words; `ticked` is the tick's state in the kernel's own words
// (true, false, mixed); `quiet` is a value the selected objects disagree on.
def PropLine(name="", shown="", said="", told="", hint="", ticked="false", read=false, choice=false, tick=false, \
             typed=false, open=false, on=false, varies=false, quiet=false, bad=false) export {
  row w=fill min-h=size.control-h-row pad=0,space.g8,0,24 gap=space.g8 role=listitem label=told transition=dur.fast {
    when hover { bg=color.control-hover }
    when open { bg=color.control-hover }
    row w=fill h=size.control-h-row align=center {
      text #name name style=text.body color=color.text-faint w=fill nowrap ellipsis
    }
    when read {
      // Read, never edited: a step quieter, whole, and wrapped when it is too long for its column.
      row w=fill pad=space.g3,space.g16,space.g3,0 {
        text shown style=text.body color=color.text-dim w=fill align-text=end
      }
    }
    when typed {
      // A focused field is scrolled 8 by the kernel to keep the caret at the end of its text
      // inside the content box, and one without the focus is not. The 8 is given up from the
      // inset while the field has the focus, so the text stands in one place either way
      // (slab/piece.slab; the host puts the caret at the end when the focus arrives and clears
      // the scroll when it leaves).
      row w=fill h=size.control-h-row pad=0,space.g4,0,0 align=center {
        text #field shown style=text.body color=color.text w=fill h=size.control-h-chip \
             pad=space.g2,space.g12,space.g2,space.g4 radius=radius.control nowrap clip align-text=end \
             field=row_edit submit=row_submit field-sync=host label=name desc=hint \
             stroke-w=1 stroke-align=inside transition=dur.fast {
          when quiet { color=color.text-faint }
          when hover { bg=color.control stroke=color.border }
          when focus { bg=color.control stroke=color.focus-ring pad=space.g2,space.g4 color=color.text }
          when bad { stroke=color.error }
        }
      }
    }
    when choice {
      row w=fill h=size.control-h-row align=center {
        row #choice w=fill h=size.control-h-chip pad=0,0,0,space.g4 gap=space.g4 radius=radius.control \
            align=center color=color.text act=row_choose role=combobox label=said expanded=open \
            stroke-w=1 transition=dur.fast {
          when quiet { color=color.text-faint }
          when hover { bg=color.control stroke=color.border }
          when open { bg=color.control stroke=color.border }
          when focus-visible { stroke=color.focus-ring }
          text shown style=text.body w=fill nowrap ellipsis align-text=end
          icon chevron size=size.icon-size-sm color=color.icon
        }
      }
    }
    when tick {
      row w=fill h=size.control-h-row pad=0,space.g16,0,0 align=center pack=end {
        row #tick w=size.icon-size-md h=size.icon-size-md radius=radius.small align=center pack=center \
            act=row_tick role=checkbox label=name checked=ticked color=color.on-accent \
            stroke=color.icon stroke-w=1 transition=dur.fast {
          when hover { bg=color.hover }
          when on { bg=color.accent stroke=color.accent }
          when varies { bg=color.accent stroke=color.accent }
          when focus-visible { stroke=color.focus-ring stroke-w=2 }
          when on { icon mark size=size.icon-size-sm }
          when varies { icon dash size=size.icon-size-sm }
        }
      }
    }
  }
}

def PropertiesPanel(summary="", open=true, listed=false, empty=false, above=false, below=false, \
                    between=false, body_max=100000, rows=list(PropLine)) export {
  col w=fill bg=color.panel select select-bg=color.accent-soft {
    row #head w=fill h=size.control-h-input pad=0,space.g8,0,space.g2 gap=space.g2 align=center \
        stroke=color.border stroke-sides=b {
      row #fold w=size.control-h-chip h=size.control-h-chip radius=radius.round align=center pack=center \
          act=fold role=button label="Hide the properties" expanded=open color=color.text-dim transition=dur.fast {
        when !open { label="Show the properties" }
        when hover { bg=color.hover color=color.text }
        when pressed { bg=color.fill-active }
        when focus-visible { stroke=color.focus-ring stroke-w=1 stroke-align=inside }
        icon chevron size=size.icon-size-sm {
          when !open { rotate=-90 }
        }
      }
      text "PROPERTIES" style=text.chip weight=700 color=color.text-faint nowrap role=heading level=2 label="Properties"
      spacer
      row h=fill pad=0,16,0,0 align=center {
        text #state summary style=text.chip color=color.text-faint nowrap ellipsis
      }
    }
    // Folded, the host hands over no rows: the body is empty, to the eye and to a screen reader.
    // A body taller than its room scrolls, and fades at the end that hides rows (the host says
    // which: `above`, `below`, `between` for both). A mask reads only its paint's alpha, and a
    // gradient's stops take no token reference: the two stops are "all" and "none", not colours
    // of the interface, and nothing is painted in them.
    col #body w=fill pad=space.g2,0 max-h=body_max scroll {
      when above { mask=linear(180, #00000000 0%, #000000 12%, #000000 100%) }
      when below { mask=linear(180, #000000 0%, #000000 88%, #00000000 100%) }
      when between { mask=linear(180, #00000000 0%, #000000 12%, #000000 88%, #00000000 100%) }
      when !open { max-h=0 pad=0 }
      when listed {
        col #rows w=fill role=list label="Properties" {
          each rows
        }
      }
      when empty {
        row w=fill h=size.control-h-row pad=0,space.g8,0,24 align=center {
          text "No properties to show." style=text.body color=color.text-faint w=fill
        }
      }
    }
  }
}
