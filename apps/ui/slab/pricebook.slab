// The body of the Price Book dialog: the jeweler's own prices for the metals and stones in the
// piece, and one labor figure. The view only, and only the body: the box, the title bar, the
// footer's keys, the backdrop, Escape and the focus trap are the interface's own dialog
// (src/ui/Dialog.tsx), which this surface stands inside (src/slab/modal.tsx).
//
// Every string and every boolean is shaped in TypeScript (src/slab/pricebook-params.ts); what is
// typed comes back as a signal with the row's key and goes through the same editor as the SolidJS
// dialog (src/pricebook-edit.ts).
//
// A price is the kernel's text field. The currency (free text) and the labor mode (a list) are the
// interface's own Field and Select, in holes: a hole cannot stand inside an `each`, and neither of
// these two rows is in one.
//
// The sentence over the form ("These are your own prices…") is the dialog's description, tied to
// the box by its id, so it stays an element of the page, over this surface.
//
// Measures follow src/dialogs.css (.jewelry, .jewelry-row, .drafting-pair, .drafting-group,
// .drafting-help, .drafting-error, .drafting-summary) and src/ui/ui.css (.ui-field): groups 16
// apart, rows 8 apart, a refusal 4 under its field, the controls in one column 164 wide (the 20ch of .drafting-pair at the body size).
import "gen/tokens.slab"

// One typed figure: its label, the field, and the refusal standing on it, in words under it.
// A focused field is scrolled 8 by the kernel to keep the caret inside its content box, and one
// without the focus is not: the 8 is given up from the inset while the field has the focus, so
// the text stands in one place either way (slab/piece.slab says the same of its rows).
// An `each` lays its items edge to edge (a column's gap does not come between them), so a row
// carries the 8 over it itself, and the groups are written around that.
def FormField(name="", shown="", hint="", bad=false) export {
  col w=fill gap=space.g4 pad=space.g8,0,0,0 {
    row w=fill h=size.control-h-input gap=space.g12 align=center {
      text name style=text.body color=color.text-dim w=fill nowrap ellipsis
      text shown style=text.body color=color.text w=164 h=size.control-h-input \
           pad=space.g4,space.g14,space.g4,space.g6 radius=radius.control nowrap clip align-text=end \
           field=field_edit submit=field_submit field-sync=host label=name desc=hint \
           bg=color.control stroke=color.border stroke-w=1 stroke-align=inside transition=dur.fast {
        when focus { stroke=color.focus-ring stroke-w=2 pad=space.g4,space.g6 }
        when bad { stroke=color.error }
      }
    }
    when bad {
      text hint style=text.label color=color.error w=fill
    }
  }
}

// What happened to the whole form: said at once to a screen reader.
def FormAlert(note="") export {
  col w=fill pad=0,0,space.g16,0 {
    row w=fill pad=space.g6,space.g8 radius=radius.card stroke=color.error stroke-w=1 role=alert label=note {
      text note style=text.body color=color.text w=fill
    }
  }
}

// A quiet sentence in the place of rows.
def FormNote(note="") export {
  row w=fill pad=space.g8,0,0,0 {
    text note style=text.label color=color.text-faint w=fill
  }
}

params {
  // The refusal on the currency, which is the host's field: the words stand under its hole.
  currency_hint text = ""
  currency_bad  bool = false
  // Zero or one. An empty list still stands between two of a column's gaps, so the groups carry
  // their own room above them and the line carries the room under it.
  alerts  list(FormAlert) = []
  metals  list(FormField) = []
  // "The drawing has no band to price.", when it has none.
  bandless list(FormNote) = []
  stones  list(FormField) = []
  // The labor amount, when a mode that takes one is picked: zero or one.
  labor   list(FormField) = []
}

col #body w=fill {
  each param.alerts
  col w=fill gap=space.g4 {
    row w=fill h=size.control-h-input gap=space.g12 align=center {
      text "Currency" style=text.body color=color.text-dim w=fill nowrap ellipsis
      hole currency w=164 h=size.control-h-input
    }
    when currency_bad {
      text param.currency_hint style=text.label color=color.error w=fill
    }
  }
  col #metals w=fill pad=space.g16,0,0,0 role=group label="Metal, per gram" {
    text "METAL, PER GRAM" style=text.chip weight=700 color=color.text-faint nowrap role=heading level=2 label="Metal, per gram"
    each param.bandless
    each param.metals
  }
  col #stones w=fill pad=space.g16,0,0,0 role=group label="Stones, per carat" {
    text "STONES, PER CARAT" style=text.chip weight=700 color=color.text-faint nowrap role=heading level=2 label="Stones, per carat"
    each param.stones
  }
  col #labor w=fill pad=space.g16,0,0,0 {
    row w=fill h=size.control-h-input gap=space.g12 align=center {
      text "Labor" style=text.body color=color.text-dim w=fill nowrap ellipsis
      hole labor w=164 h=size.control-h-input
    }
    each param.labor
  }
}
