// The Objects section of the sidebar: a search over the tree of what the drawing holds. The view
// only: the engine's list is read, arranged, filtered, capped and walked in TypeScript
// (src/objects.ts, src/slab/objects-params.ts), and every press comes back as a signal. The
// search field is the host's, in a hole.
//
// The tree is one flat list of rows in reading order, each stepped in by its level (`indent`: a
// first-level row starts on the row's own gap, the heading's inset) and
// carrying its level, place and set size for assistive tech: a `virtual` list must be a root
// list, so the nesting is in the rows' data and not in nested lists. Only the rows in view (and a
// few each side) are laid out.
//
// Measures follow src/interaction.css (.properties-head, .objects-search, .objects-row,
// .objects-twist, .objects-count, .properties-empty) and src/ui/ui.css (.ui-field): the heading
// and the field are 24 high, a row 22, the twist is a cell the size of the heading's fold key.
//
// A box with children never carries a stroke the web driver paints as a CSS border (a stroke on
// some sides, or `stroke-align=inside`): the driver positions the children inside that border,
// one stroke-width off the solved scene. So the section's top edge is a hairline of its own, and
// a focus ring is a centred stroke (an outline).
import "gen/tokens.slab"

// The glyphs are the interface's own (src/icons.ts: chevron-down, chevron-right). There
// the stroke is 1.25 px whatever the glyph's size; here it scales with the glyph, so it is
// written for the size each is drawn at (12 of a 24 box).
icon chevron viewbox=24 {
  path "M6 9l6 6 6-6" bg=none stroke=current stroke-w=2.5
}
icon twist viewbox=24 {
  path "M9 6l6 6-6 6" bg=none stroke=current stroke-w=2.5
}
// One run of a row's name: the characters a search matched are in the accent's text ink.
def ObjectRun(t="", hit=false) export {
  span t {
    when hit { color=color.text-accent weight=600 }
  }
}

// One row of the tree: a group (a twist, a name, how many it holds), one object, or the row that
// shows the rest of a long group. A press anywhere selects; a press on a group's twist opens or
// closes it (the host tells the two apart by where the pointer was).
def ObjectRow(name="", indent=0, group=false, opened=false, more=false, current=false, tally="", \
              depth=1, place=1, total=1, runs=list(ObjectRun)) export {
  row w=fill h=size.control-h-row gap=space.g2 align=center color=color.text-dim \
      role=treeitem label=name level=depth pos-in-set=place set-size=total selected=current \
      act=row_pressed transition=dur.fast {
    when group { expanded=opened }
    when more { color=color.text-accent }
    when hover { bg=color.hover }
    when current { bg=color.fill-active color=color.text }
    when focus-visible { stroke=color.focus-ring stroke-w=2 }
    rect w=indent h=fill
    row #twist w=size.control-h-chip h=fill align=center pack=center color=color.icon {
      when group {
        icon twist size=size.icon-size-sm {
          when opened { rotate=90 }
        }
      }
    }
    para w=fill h=hug nowrap ellipsis style=text.body {
      each runs
    }
    text tally style=text.chip color=color.text-faint nowrap
    rect w=space.g8 h=fill
  }
}

// A sentence in the place of the tree or under it: it wraps.
def ObjectNote(note="") export {
  row w=fill pad=space.g2,space.g8,space.g2,24 {
    text note style=text.body color=color.text-faint w=fill
  }
}

params {
  summary text = ""
  open    bool = true
  // The drawing has objects to list: the search and the tree show.
  listed  bool = false
  // The tree has rows. With none (a search found nothing) it gives its room up, and the line
  // that says so stands under the search.
  filled  bool = false
  rows    list(ObjectRow) = []
  notes   list(ObjectNote) = []
}

col #panel w=fill h=fill bg=color.panel {
  rect #edge w=fill h=size.hairline bg=color.border
  row #head w=fill h=size.control-h-input pad=0,space.g8,0,space.g2 gap=space.g2 align=center \
      stroke=color.border stroke-sides=b {
    row #fold w=size.control-h-chip h=size.control-h-chip radius=radius.round align=center pack=center \
        act=fold role=button label="Hide the objects" expanded=param.open color=color.text-dim transition=dur.fast {
      when !open { label="Show the objects" }
      when hover { bg=color.hover color=color.text }
      when pressed { bg=color.fill-active }
      when focus-visible { stroke=color.focus-ring stroke-w=2 }
      icon chevron size=size.icon-size-sm {
        when !open { rotate=-90 }
      }
    }
    text "OBJECTS" style=text.chip weight=700 color=color.text-faint nowrap role=heading level=2 label="Objects"
    spacer
    text param.summary style=text.chip color=color.text-faint nowrap ellipsis role=status
  }
  // The search and the tree are children of a `when`, so they are absent (to the eye, the
  // keyboard and a screen reader) while there is nothing to list. A `when`'s children come after
  // the node's own, so they have a box of their own to keep the lines under them.
  col #body w=fill h=fill {
    when !filled { h=hug }
    when listed {
      // The search is the interface's own field (src/ui/Field.tsx), in a hole: see SlabObjects.tsx
      // for what the kernel's text field lacks. The insets are .objects-search's.
      row #search w=fill pad=space.g4,space.g8,space.g2,space.g6 {
        hole search w=fill h=size.control-h-input
      }
      col #tree w=fill h=fill pad=space.g2,0 scroll scrollbar=auto scrollbar-fg=color.scrollbar scrollbar-bg=none \
          role=tree label="Objects" {
        when !filled { max-h=0 pad=0 }
        each param.rows key=rows virtual item-extent=22 overscan=6
      }
    }
  }
  col #notes w=fill {
    each param.notes
  }
}
