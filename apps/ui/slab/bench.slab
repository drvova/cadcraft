// The Bench section of the sidebar: the piece's stones and metal as lines, then the estimated
// cost. The view only: the sheet is read and the lines are shaped in TypeScript
// (src/bench.ts, src/slab/bench-params.ts), and every press comes back as a signal.
//
// Measures follow src/interaction.css (.properties-head, .bench-line, .prop-row, .bench-cost):
// the heading is 24 high, a row 22, a label starts on the rail's text column (24 in) and a value
// ends 24 before the edge.
import "gen/tokens.slab"

icon chevron viewbox=24 {
  path "M6 9l6 6 6-6" bg=none stroke=current stroke-w=2
}

// One line of the sheet. A line the engine named objects for is pressed to select them on the
// drawing (`current` while they are all selected); one it named none for is text.
def BenchLine(name="", amount="", hint="", pressable=false, current=false) export {
  row w=fill pad=0,20 role=listitem {
    row w=fill h=size.control-h-row pad=0,4 gap=space.g8 align=center radius=radius.card \
        color=color.text-dim role=button label=name desc=hint selected=current transition=dur.fast {
      when !pressable { color=color.text-faint role=none }
      when pressable { act=line_pressed }
      when hover { bg=color.hover }
      when current { bg=color.fill-active color=color.text }
      when focus-visible { stroke=color.focus-ring stroke-w=1 stroke-align=inside }
      text name style=text.body w=fill nowrap ellipsis
      text amount style=text.body color=color.text-dim nowrap
    }
  }
}

// What the engine found wrong with a stone's record, and a line it could not price.
def BenchNote(note="") export {
  row w=fill pad=space.g2,space.g8,space.g2,24 role=listitem {
    text note style=text.chip color=color.warn w=fill
  }
}

// A line of the cost the engine could not price, inside the cost group's inset.
def BenchUnpriced(note="") export {
  row w=fill role=listitem {
    text note style=text.chip color=color.warn w=fill
  }
}

def BenchPanel(summary="", open=true, empty=true, costed=false, labored=false, settable=false, \
               metal="", stones="", labor="", total="", \
               lines=list(BenchLine), warnings=list(BenchNote), unpriced=list(BenchUnpriced)) export {
  col w=fill bg=color.panel stroke=color.border stroke-sides=t select select-bg=color.accent-soft {
    row #head w=fill h=size.control-h-input pad=0,space.g8,0,space.g2 gap=space.g2 align=center \
        stroke=color.border stroke-sides=b {
      row #fold w=size.control-h-chip h=size.control-h-chip radius=radius.round align=center pack=center \
          act=fold role=button label="Hide the bench sheet" expanded=open color=color.text-dim transition=dur.fast {
        when !open { label="Show the bench sheet" }
        when hover { bg=color.hover color=color.text }
        when pressed { bg=color.fill-active }
        when focus-visible { stroke=color.focus-ring stroke-w=1 stroke-align=inside }
        icon chevron size=size.icon-size-sm {
          when !open { rotate=-90 }
        }
      }
      text "BENCH" style=text.chip weight=700 color=color.text-faint nowrap role=heading level=2 label="Bench"
      spacer
      row h=fill pad=0,16,0,0 align=center {
        text summary style=text.chip color=color.text-faint nowrap ellipsis
      }
    }
    col #body w=fill pad=space.g2,0 clip {
      // Folded, the host hands over no lines and no cost: the body is empty, to the eye and to a screen reader.
      when !open { max-h=0 pad=0 }
      col #lines w=fill role=list label="Bench sheet" {
        each lines
        each warnings
        when empty {
          row w=fill h=size.control-h-row pad=0,space.g8,0,24 align=center role=listitem {
            text "No stones or bands yet." style=text.body color=color.text-faint
          }
        }
      }
      when costed {
        col #cost w=fill gap=space.g4 pad=space.g8,24,space.g6,24 clip role=group label="Estimated cost" \
            stroke=color.border-soft stroke-sides=t {
          row w=fill align=center {
            text "COST" style=text.chip weight=700 color=color.text-faint nowrap role=heading level=2 label="Cost"
            spacer
            row #edit h=size.control-h-input pad=space.g2,space.g6 radius=radius.control align=center \
                act=edit_prices role=button desc="Change the drawing's prices" color=color.text-dim transition=dur.fast {
              when hover { bg=color.hover color=color.text }
              when pressed { bg=color.fill-active color=color.text }
              when focus-visible { stroke=color.focus-ring stroke-w=1 stroke-align=inside }
              text "Edit prices" style=text.body nowrap
            }
          }
          col w=fill gap=space.g2 color=color.text-dim {
            row w=fill gap=space.g8 { text "Metal" style=text.label w=fill; text metal style=text.label nowrap }
            row w=fill gap=space.g8 { text "Stones" style=text.label w=fill; text stones style=text.label nowrap }
            row w=fill gap=space.g8 clip {
              when !labored { max-h=0 inert }
              text "Labor" style=text.label w=fill
              text labor style=text.label nowrap
            }
            row w=fill gap=space.g8 color=color.text {
              text "Total" style=text.label weight=600 w=fill
              text total style=text.label weight=600 nowrap
            }
          }
          col w=fill pad=0 {
            each unpriced
          }
          text "An estimate from the prices you set, not a market quote." style=text.chip color=color.text-faint w=fill
        }
      }
      when settable {
        row #set w=fill pad=space.g6,24 {
          row #setprices h=size.control-h-input pad=space.g2,space.g6 radius=radius.control align=center \
              act=edit_prices role=button desc="Price the metal and stones to estimate what the piece costs" \
              color=color.text-dim transition=dur.fast {
            when hover { bg=color.hover color=color.text }
            when pressed { bg=color.fill-active color=color.text }
            when focus-visible { stroke=color.focus-ring stroke-w=1 stroke-align=inside }
            text "Set prices to estimate cost" style=text.body nowrap
          }
        }
      }
    }
  }
}
