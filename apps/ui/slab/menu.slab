// ---- end of the generated glyphs ----

// The edge of an open group a row stands in: one per level it is nested (a stacked menu only).
def MenuGuide(on=true) export {
  row w=menu.guide h=fill pad-l=space.g12 {
    rect w=size.hairline h=fill bg=color.border
  }
}

// One row, or the separator above a group (`sep`), as few nodes as it can be: every node of a
// row is laid out, put in the scene and synced to the accessibility layer on every frame, and a
// menu has thirty rows. `caption` is the row's label and `short` its shortcut (a prop named
// `label` or `keys` would shadow the attribute). The tracks are the host's: `lw` the label's with
// the room after it (less the glyph's box, when the row has one), `nw` the typed name's with the
// room after it (0 when it is not drawn), `sw` the shortcut's; `rh` the row's height (a row, a
// separator, each a step taller under a finger). `off` is a row that is not available: it keeps
// its place and the keyboard still reaches it (the host says it is unavailable, and does not run
// it). `sub` opens a submenu and `open` is the one that is open (`down`: in place, under it, its
// chevron turned down); `lit` is the row under the pointer or the keyboard, or the open one.
// `said` is the typed name said as the row's description; `pos` and `count` its place in its own
// list (a stacked menu holds the groups opened in place in the same one).
def MenuRow(caption="", name="", short="", said="", glyph="", iconed=false, sub=false, open=false, off=false, lit=false, \
            down=false, sep=false, pos=1, count=1, rh=24, lw=0, nw=0, sw=0, guides=list(MenuGuide)) export {
  row w=fill {
    each guides
    row #row w=fill h=rh pad=0,space.g8 align=center radius=menu.row-radius color=color.text {
      // (A `when`'s children come after the node's own, in the order the patches are written: so
      // the row has none of its own, and the glyph's patch comes before the texts'.)
      when sep {
        role=separator
        rect w=fill h=size.hairline bg=color.border
      }
      when sub { pad-r=menu.end-pad expanded=open }
      when lit { bg=color.hover }
      when off { bg=none color=color.text-disabled }
      when focus-visible { stroke=color.focus-ring stroke-w=1 stroke-align=inside }
      when iconed {
        row w=menu.glyph-box h=fill align=center inert {
          icon glyph size=size.icon-size-md color=color.icon {
            when off { color=color.text-disabled }
          }
        }
      }
      when !sep {
        role=menuitem label=caption desc=said pos-in-set=pos set-size=count act=row
        text caption style=text.body w=lw nowrap ellipsis inert
        text name style=text.mono w=nw color=color.text-faint nowrap clip inert {
          when lit { color=color.text-dim }
          when off { color=color.text-disabled }
        }
        text short style=text.label w=sw align-text=end color=color.text-faint nowrap clip inert {
          when off { color=color.text-disabled }
        }
      }
      when sub {
        icon glyph-chevron-right size=size.icon-size-sm color=color.text-faint inert {
          when down { rotate=90 }
        }
      }
    }
  }
}

// A column of rows, as wide as its widest row's tracks.
def MenuColumn(cw=0, rows=list(MenuRow)) export {
  col w=cw {
    each rows
  }
}

params {
  // The box: its outer width and height (the host works both out before the surface is laid out,
  // so the menu is placed in the window in the same turn as it is asked for).
  w num = 0
  h num = 0
  cols list(MenuColumn) = []
}

col #menu w=param.w h=param.h pad=menu.inset bg=color.surface-elevated stroke=color.border stroke-w=size.hairline \
    stroke-align=inside radius=radius.popover {
  col #body w=fill h=fill scroll {
    row #cols gap=space.g4 {
      each param.cols
    }
  }
}
