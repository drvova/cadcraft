// A menu: one level of the menus the menu bar's titles, the Main menu key, the ribbon's overflow
// key and a right click open. Its rows stand in columns (a menu taller than the window runs on
// into a second one); in a window with no room beside a row (`stacked`) it is one column that
// scrolls, and a submenu opens in place as an indented group under its row. The view only: which
// rows there are, which column each starts, how wide each track is, which row is lit and which
// group is open are shaped in TypeScript (src/slab/menu-params.ts, over the rules of
// src/menu.ts that the SolidJS menu, src/components/Menu.tsx, is drawn by). A submenu beside
// its row is another surface of this document: a surface's overlay cannot leave its box.
//
// No node binds `pointer-move` and none eases with `transition=`, each of which has the kernel
// solve a frame per step; nothing is lit by the kernel's own hover either. The host finds the row
// under the pointer in the solved scene and lights it (`lit`), so a pointer drawn down the rows
// asks for one frame per row it enters and none for the moves inside a row. A row's parts are
// `inert`.
//
// Measures follow src/chrome.css (.menu-drop, .menu-separator, .menu-name, .menu-shortcut,
// .menu-arrow, .menu-drop.is-stacked) and src/ui/ui.css (.ui-row--menuitem): the box is the
// popover (its inset 4 inside a hairline, its 14 corner), a row an input high (a button's under
// a finger) on an 8 inset, its corner the box's less the inset and the hairline; a separator is
// half a row with a hairline across the text's run; the typed name is the mono face in the quiet
// ink, a step brighter on the lit row; a group opened in place stands 12 in, past a hairline.
import "gen/tokens.slab"

tokens {
  menu {
    // The box's inset and its hairline: where the rows start.
    inset 5
    // A row's corner: the popover's 14 less the inset (4) and the hairline.
    row-radius 9
    // A group opened in place: 12 in, a hairline, 4 more.
    guide 17
    // A row's glyph (the overflow menu's) and the room after it.
    glyph-box 22
    // A submenu row's inset at its end: the chevron's box stands 4 past the shortcuts' edge.
    end-pad 4
  }
}

