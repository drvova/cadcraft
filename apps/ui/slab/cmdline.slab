// The command line, the editor's bottom panel: the history of what was typed and answered, the
// running command's keywords as keys that answer with one, the typed line, and beside it what was
// refused. The view only: the lines are wrapped, the keywords set in rows and the panel's height
// worked out in TypeScript (src/slab/cmdline-params.ts), and a pressed keyword comes back as a
// signal. The typed line is the host's own field, in a hole (src/slab/SlabCommandLine.tsx says
// why).
//
// Measures follow src/styles.css (.cmdline and below), src/interaction.css (.cmd-chips) and
// src/ui/ui.css (.ui-chip): a hairline over the band, 6 above and below, 4 between its parts; the
// history in the mono face on the layer's 16 line, five lines before it scrolls, starting on the
// panel's column (12 in) and ending 8 before its far edge; a keyword is a 20 pill on the accent's
// soft fill, in a row 24 high that starts 4 in so that its word reads on the column; the typed
// line is the field's 24.
//
// No `transition=` and no `pointer-move=` anywhere: each costs a solve per step, and this panel is
// laid out again with every line of a script.
import "gen/tokens.slab"

tokens {
  cmd {
    // The type size of what is read out and not drawn (the prompt, said again when it changes).
    said 0.01
    // An error's line (styles.css: `.cmd-error`, 12px type on a line of 14: a hair under 14, so that two lines are counted into 28).
    err-leading 1.166
  }
}

// One painted line of the history. A line longer than the panel is wide is cut into several by
// the host (a `virtual` list's items are all one height), each its own item. `newest` is the
// line being answered: it takes the stronger ink.
def CmdLine(t="", newest=false) export {
  row w=fill h=size.leading-ui pad=0,space.g8,0,space.g12 color=color.text-faint {
    when newest { color=color.text-dim }
    text t style=text.mono nowrap
  }
}

// One keyword of the running command's prompt: a press answers the prompt with it. The room
// between two keywords is before each one but a row's first (`lead`: an `each` sets its items side
// by side and takes no gap).
def CmdKey(word="", lead=false) export {
  row {
    when lead { pad-l=space.g4 }
    row h=size.control-h-chip pad=0,space.g8 radius=radius.round align=center \
        bg=color.accent-soft color=color.text-accent act=keyword role=button label=word {
      when hover { bg=color.hover }
      when pressed { bg=color.hover }
      when focus-visible { stroke=color.focus-ring stroke-w=1 stroke-align=inside }
      text word style=text.chip nowrap
    }
  }
}

// One row of keywords. The host sets them in rows by their measured widths: an `each` directly
// under a `wrap` is one block at this commit.
def CmdKeyRow(words=list(CmdKey)) export {
  row w=fill h=size.control-h-input pad=space.g2,space.g8,space.g2,space.g4 align=center {
    each words
  }
}

params {
  lines    list(CmdLine) = []
  // The history's height: its lines, five at most. 0 while it is empty.
  out_h    num = 0
  // The band's inset above and below, and the room under the history and under the keywords
  // (the band's 4 while there is one, else 0). They are the host's because an error of two lines
  // takes 2 of the room above and below the typed line's row.
  pad_t    num = 6
  pad_b    num = 6
  out_gap  num = 0
  keys_gap num = 0
  // The typed line's row: the field's 24, or an error's two lines.
  entry_h  num = 24
  key_rows list(CmdKeyRow) = []
  // The prompt, said again for a screen reader when it changes.
  said     text = "Command:"
  // What was refused, beside the typed line; `failed` while there is something to say.
  failed   bool = false
  error    text = ""
  // The error's width: its words' when they fit on one line, else 40 characters or half the
  // panel, the lesser (`max-w` takes no percentage), and it wraps. And its ink (a `color-mix` in
  // the sheet, which the token bridge does not carry).
  err_w    num = 240
  err_ink  color = #00000000
}

col #band w=fill h=fill bg=color.cmd-bg {
  // The band's top edge, and in it the line that is not drawn.
  row #edge w=fill h=size.hairline bg=color.cmd-border clip {
    text param.said style=text.label size=cmd.said opacity=0 nowrap role=status
  }
  col #body w=fill h=fill {
    rect w=fill h=param.pad_t
    // The history. It is in the tree before its first line, so a screen reader hears that line
    // arrive. Its text is selectable: nothing in it takes the focus.
    col #out w=fill h=param.out_h scroll scrollbar=auto scrollbar-fg=color.scrollbar scrollbar-bg=none \
        select select-bg=color.accent-soft role=log label="Command history" {
      each param.lines key=lines virtual item-extent=16 overscan=4
    }
    rect w=fill h=param.out_gap
    col #keys w=fill role=group label="Keywords" {
      each param.key_rows key=rows
    }
    rect w=fill h=param.keys_gap
    row #entry w=fill h=param.entry_h gap=space.g6 align=center {
      // The typed line is the interface's own field (src/components/CommandField.tsx).
      hole field w=fill h=size.control-h-input
      when failed {
        text #error param.error style=text.label leading=cmd.err-leading w=param.err_w max-h=param.entry_h \
            ellipsis color=param.err_ink role=alert label=param.error focusable {
          when focus-visible { underline }
        }
        rect w=space.g2 h=fill
      }
    }
    rect w=fill h=param.pad_b
  }
}
