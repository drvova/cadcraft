// The body of the Layer Properties Manager: the actions and the filter over a grid of every layer
// of the drawing. The view only, and only the body: the box, the title bar, the Close key, the
// backdrop, Escape and the focus trap are the interface's own dialog (src/ui/Dialog.tsx), which
// this surface stands inside (src/slab/modal.tsx).
//
// Every string and every boolean is shaped in TypeScript (src/slab/layer-manager-params.ts); the
// state, the engine calls and the keys are the SolidJS dialog's own (src/layer-manager-edit.ts).
//
// The grid is ONE focusable node (`#grid`), as the SolidJS grid is one Tab stop: the host takes
// every key on it before the kernel (the arrows, Home, End, the page keys, F2, Enter, Space, a
// typed letter) and moves the active cell, which the rows draw (`a0` to `a10`) and which a screen
// reader is told through `active-descendant`. A press anywhere on the grid comes back as one
// signal whose `hit_key` names the cell.
//
// Only the rows near the viewport are handed over, as the SolidJS grid draws only those: the host
// windows the list and the two spacers (`above`, `below`) stand for the rest. A `virtual` list
// was built and measured first: the web element writes a list whole (`setList`), so every key
// that moved the selection re-sent all the rows, 250 ms a key with 2,000 layers. Rows are one
// height each, so a refusal is said at the foot of the grid's frame, not under its row, and the
// refused row's name is drawn in the error ink.
//
// The filter is the interface's own field in a hole (src/slab/SlabLayerManager.tsx says why), and
// a name or a description is typed in the interface's own field laid over its cell.
//
// Measures follow src/dialogs.css (.lm, .lm-bar, .lm-scroll, .lm-head, .lm-row, .lm-cell…).
import "gen/tokens.slab"

tokens {
  lm {
    // The columns (dialogs.css: --lm-mark-w, --lm-flag-w, 14ch, --lm-weight-w, --lm-clear-w, and
    // the two minimums), at the interface's 13 px body face. The name takes what is left; the
    // description keeps its least width (dialogs.css gives it a quarter of what is left once that
    // passes four times its least, which the dialog is never wide enough for, and a fill's least
    // width here is not given back to the other fill as a grid track's is).
    mark-w 32
    flag-w 28
    name-min 130
    choice-w 114
    weight-w 94
    clear-w 71
    note-min 97
    // The current row's accent edge, the "has objects" diamond, the colour swatch.
    edge 2
    used 7
    swatch 10
    // The sort caret's room beside a heading.
    caret 8
  }
}

// ---- glyphs: generated from src/icons.ts by src/slab/ribbon-icons.ts; do not edit ----
icon glyph-chevron-right viewbox=24 {
  path "M9 6l6 6-6 6" bg=none stroke=current stroke-w=2.5
}
icon glyph-chevron-down viewbox=24 {
  path "M6 9l6 6 6-6" bg=none stroke=current stroke-w=2.5
}
icon glyph-layer-on viewbox=24 {
  path "M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z M12 9.5a2.5 2.5 0 1 0 0 5a2.5 2.5 0 1 0 0-5z" bg=none stroke=current stroke-w=2.5
}
icon glyph-layer-off viewbox=24 {
  path "M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z M4 4l16 16" bg=none stroke=current stroke-w=2.5
}
icon glyph-layer-frozen viewbox=24 {
  path "M12 3v18 M4.2 7.5l15.6 9 M19.8 7.5l-15.6 9 M9.5 4.5L12 7l2.5-2.5 M9.5 19.5L12 17l2.5 2.5" bg=none stroke=current stroke-w=2.5
}
icon glyph-layer-thawed viewbox=24 {
  path "M12 8a4 4 0 1 0 0 8a4 4 0 1 0 0-8z M12 2v3 M12 19v3 M2 12h3 M19 12h3 M5 5l2 2 M17 17l2 2 M19 5l-2 2 M7 17l-2 2" bg=none stroke=current stroke-w=2.5
}
icon glyph-layer-locked viewbox=24 {
  path "M6 11h12v9H6z M8.5 11V8a3.5 3.5 0 0 1 7 0v3" bg=none stroke=current stroke-w=2.5
}
icon glyph-layer-unlocked viewbox=24 {
  path "M6 11h12v9H6z M8.5 11V8a3.5 3.5 0 0 1 6.8-1" bg=none stroke=current stroke-w=2.5
}
icon glyph-plot viewbox=24 {
  path "M6.75 8.25v-4.5h10.5v4.5 M5.75 8.25h12.5a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H5.75a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2z M6.75 14.25h10.5v6h-10.5z" bg=none stroke=current stroke-w=2.5
}
icon glyph-close viewbox=24 {
  path "M6 6l12 12 M18 6L6 18" bg=none stroke=current stroke-w=2.5
}
// ---- end of the generated glyphs ----

// One heading of the grid: a word, or a flag's glyph, or the status column's mark, and the sort
// caret's room beside it (down: descending; up: ascending). `ring` is the keyboard on it.
def LmHead(name="", hint="", word="", glyph="", cw=0, worded=false, wide=false, flag=false, status=false, \
           sorted=false, up=false, ring=false) export {
  row #head w=cw min-w=cw h=fill align=center role=columnheader label=name desc=hint color=color.text-dim {
    when wide { w=fill }
    when ring { stroke=color.focus-ring stroke-w=2 }
    row h=size.control-h-input pad=0,space.g6 align=center radius=radius.control {
      when flag { pad=0 w=size.control-h-chip pack=center color=color.icon }
      when status { pad=0,0,0,space.g6 }
      when hover { bg=color.hover color=color.text }
      when status {
        rect w=lm.used h=lm.used radius=1 rotate=45 bg=color.icon
      }
      when flag {
        icon glyph size=size.icon-size-sm
      }
      when worded { text word style=text.body nowrap }
    }
    row w=lm.caret h=fill align=center pack=center color=color.icon {
      when sorted {
        icon glyph-chevron-down size=size.icon-size-sm {
          when up { rotate=180 }
        }
      }
    }
  }
}

// One layer. A cell's ring (`a0`…`a10`) is the keyboard on it; `quiet` keys are drawn faint.
def LmRow(name="", said="", picked=false, current=false, used=false, refused=false, typing=false, \
          noting=false, hot=false, status="", \
          on=true, frozen=false, locked=false, plot=true, \
          on_name="", frozen_name="", locked_name="", plot_name="", \
          off_ink=#00000000, frozen_ink=#00000000, locked_ink=#00000000, \
          tone=#00000000, tone_name="", hue="", linetype="", lineweight="", clear="", note="", \
          color_said="", linetype_said="", lineweight_said="", clear_said="", note_said="", \
          a0=false, a1=false, a2=false, a3=false, a4=false, a5=false, a6=false, a7=false, a8=false, \
          a9=false, a10=false) export {
  row #row w=fill h=size.control-h-row role=row desc=said selected=picked color=color.text {
    when hover { bg=color.hover }
    when picked { bg=color.list-row }
    // Status: the current layer's accent edge, the "has objects" mark, the current mark.
    // A part that only some rows draw is a `when`'s child, not a box kept empty: a row's nodes
    // are laid out, painted and mirrored for a screen reader on every frame.
    row #c0 w=lm.mark-w h=fill gap=space.g4 align=center role=gridcell label=status {
      when a0 { stroke=color.focus-ring stroke-w=2 }
      rect w=lm.edge h=fill {
        when current { bg=color.accent }
      }
      rect w=lm.used h=lm.used radius=1 rotate=45 stroke=color.text-faint stroke-w=1 {
        when used { bg=color.icon stroke=color.icon }
      }
      when current { icon glyph-chevron-right size=size.icon-size-sm color=color.text-accent }
    }
    row #c1 w=fill min-w=lm.name-min h=fill pad=0,space.g6 align=center role=gridcell label=name \
        color=color.text-dim {
      when a1 { stroke=color.focus-ring stroke-w=2 }
      when picked { color=color.text }
      when current { color=color.text }
      when refused { color=color.error }
      when typing { color=#00000000 }
      text name style=text.body w=fill nowrap ellipsis
    }
    row #c2 w=lm.flag-w h=fill align=center role=gridcell label=on_name {
      when a2 { stroke=color.focus-ring stroke-w=2 }
      row w=size.control-h-chip h=fill align=center pack=center radius=radius.small color=off_ink \
          role=switch label=on_name checked=on {
        when hover { bg=color.hover }
        when on { color=color.icon }
        when on { icon glyph-layer-on size=size.icon-size-sm }
        when !on { icon glyph-layer-off size=size.icon-size-sm }
      }
    }
    row #c3 w=lm.flag-w h=fill align=center role=gridcell label=frozen_name {
      when a3 { stroke=color.focus-ring stroke-w=2 }
      row w=size.control-h-chip h=fill align=center pack=center radius=radius.small color=color.icon \
          role=switch label=frozen_name checked=frozen {
        when hover { bg=color.hover }
        when frozen { color=frozen_ink }
        when frozen { icon glyph-layer-frozen size=size.icon-size-sm }
        when !frozen { icon glyph-layer-thawed size=size.icon-size-sm }
      }
    }
    row #c4 w=lm.flag-w h=fill align=center role=gridcell label=locked_name {
      when a4 { stroke=color.focus-ring stroke-w=2 }
      row w=size.control-h-chip h=fill align=center pack=center radius=radius.small color=color.icon \
          role=switch label=locked_name checked=locked {
        when hover { bg=color.hover }
        when locked { color=locked_ink }
        when locked { icon glyph-layer-locked size=size.icon-size-sm }
        when !locked { icon glyph-layer-unlocked size=size.icon-size-sm }
      }
    }
    row #c5 w=lm.flag-w h=fill align=center role=gridcell label=plot_name {
      when a5 { stroke=color.focus-ring stroke-w=2 }
      row w=size.control-h-chip h=fill align=center pack=center radius=radius.small color=off_ink \
          role=switch label=plot_name checked=plot {
        when hover { bg=color.hover }
        when plot { color=color.icon }
        when plot { icon glyph-plot size=size.icon-size-sm }
        when !plot { icon glyph-close size=size.icon-size-sm }
      }
    }
    row #c6 w=lm.choice-w h=fill pad=0,space.g2,0,space.g6 gap=space.g2 align=center role=gridcell \
        label=color_said {
      when a6 { stroke=color.focus-ring stroke-w=2 }
      rect w=lm.swatch h=lm.swatch radius=radius.small bg=tone stroke=color.swatch-border stroke-w=1 \
           role=img label=tone_name
      text hue style=text.body w=fill pad=0,0,0,space.g4 nowrap ellipsis
      when hot { icon glyph-chevron-down size=size.icon-size-sm color=color.icon }
    }
    row #c7 w=lm.choice-w h=fill pad=0,space.g2,0,space.g6 align=center role=gridcell \
        label=linetype_said {
      when a7 { stroke=color.focus-ring stroke-w=2 }
      text linetype style=text.body w=fill nowrap ellipsis
      when hot { icon glyph-chevron-down size=size.icon-size-sm color=color.icon }
    }
    row #c8 w=lm.weight-w h=fill pad=0,space.g2,0,space.g6 align=center role=gridcell \
        label=lineweight_said {
      when a8 { stroke=color.focus-ring stroke-w=2 }
      text lineweight style=text.body w=fill nowrap ellipsis
      when hot { icon glyph-chevron-down size=size.icon-size-sm color=color.icon }
    }
    row #c9 w=lm.clear-w h=fill pad=0,space.g2,0,space.g6 align=center role=gridcell label=clear_said {
      when a9 { stroke=color.focus-ring stroke-w=2 }
      text clear style=text.body w=fill nowrap ellipsis
      when hot { icon glyph-chevron-down size=size.icon-size-sm color=color.icon }
    }
    row #c10 w=lm.note-min h=fill pad=0,space.g6 align=center role=gridcell \
        label=note_said color=color.text-dim {
      when a10 { stroke=color.focus-ring stroke-w=2 }
      when noting { color=#00000000 }
      text note style=text.body w=fill nowrap ellipsis
    }
  }
}

// A key of the bar over the grid (ui.css: .ui-button--secondary, --sm). `off`: it cannot act now,
// and `why` says so; it stays a Tab stop, as the SolidJS key stays one (`aria-disabled`), and the
// host does nothing with its press.
def LmKey(name="", why="", off=false) export {
  row #key h=size.control-h-input pad=space.g2,space.g6 radius=radius.control align=center \
      bg=color.hover color=color.text act=bar_press role=button label=name desc=why {
    when hover { bg=color.fill-active }
    when off { bg=color.fill-disabled color=color.text-disabled }
    when focus-visible { stroke=color.focus-ring stroke-w=2 }
    text name style=text.body nowrap
  }
}

params {
  keys    list(LmKey) = []
  count   text = ""
  heads   list(LmHead) = []
  rows    list(LmRow) = []
  // The grid's width (at least its columns'; the frame scrolls it sideways when it is wider) and
  // the frame's height (twenty rows, at most half the window).
  grid_w  num = 764
  find_w  num = 260
  // The rows not handed over, before and after the ones that are, as the room they take.
  above   num = 0
  below   num = 0
  view_h  num = 440
  // The full key of the cell the keyboard is on, for a screen reader.
  active  text = ""
  // The grid's name, with how many rows it has.
  grid_said text = "Layers"
  // No row to show: the words, and whether a filter is what hides them.
  empty   bool = false
  empty_said text = ""
  filtered bool = false
  // What the engine refused in the last change, under the grid.
  refused bool = false
  refusal text = ""
}

col #lm w=fill gap=space.g8 {
  wrap #bar w=fill gap=space.g8,space.g12 align=center role=group label="Layer actions" {
    row #actions gap=space.g6 align=center {
      each param.keys
    }
    // As wide as what the keys leave on their line, or the whole line under them (the host
    // measures): a `fill` in a `wrap` does not take the rest of its line here.
    row #find w=param.find_w min-w=param.find_w gap=space.g8 align=center pack=end {
      hole filter w=fill min-w=97 max-w=227 h=size.control-h-input
      text param.count style=text.label color=color.text-faint nowrap role=status
    }
  }
  // The grid's window, and at its foot, while there is one, what the engine refused: the frame
  // keeps its height, so the dialog does not move (the SolidJS grid opens a line under the row).
  col #frame w=fill h=param.view_h pad=size.hairline radius=radius.card stroke=color.border stroke-w=1 clip {
   col #pane w=fill h=fill scroll=cross scrollbar=auto scrollbar-fg=color.scrollbar scrollbar-bg=none {
    col #grid w=param.grid_w h=fill scroll scrollbar=auto scrollbar-fg=color.scrollbar scrollbar-bg=none \
        focusable role=grid label=param.grid_said active-descendant=param.active \
        act=grid_press dblclick=grid_double {
      col #top sticky w=fill bg=color.surface-elevated {
        row #heads w=fill h=size.control-h-input role=row {
          each param.heads
        }
        rect w=fill h=size.hairline bg=color.border
      }
      rect #above w=fill h=param.above
      each param.rows key=rows
      rect #below w=fill h=param.below
      when empty {
        row #empty w=fill pad=space.g12 gap=space.g8 align=center {
          text param.empty_said style=text.body color=color.text-faint
          when filtered {
            row #clear h=size.control-h-input pad=space.g2,space.g6 radius=radius.control align=center \
                color=color.text act=clear_filter role=button label="Clear the filter" {
              when hover { bg=color.hover }
              when focus-visible { stroke=color.focus-ring stroke-w=2 }
              text "Clear the filter" style=text.body nowrap
            }
          }
        }
      }
    }
   }
   when refused {
     rect w=fill h=size.hairline bg=color.border
     row #refusal w=fill pad=space.g4,space.g6 bg=color.surface-elevated role=alert label=param.refusal {
       text param.refusal style=text.label color=color.error w=fill
     }
   }
  }
}
