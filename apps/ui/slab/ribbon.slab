// ---- end of the generated glyphs ----

// One tab of the tab row. `front` is the one whose tools the band holds; `cap` the widest a tab
// may be (18 characters of the page's face: ui.css, `.ui-tab--sm`). The room between two tabs is
// before each one but the first (`lead`: an `each` sets its items side by side and takes no gap).
def RibbonTabKey(name="", front=false, lead=true, cap=200) export {
  row {
    when lead { pad-l=space.g2 }
    row h=size.control-h-row max-w=cap pad=0,space.g6 align=center radius=radius.card color=color.text-faint \
        role=tab label=name selected=front act=tab {
      when coarse { h=size.control-h-input min-w=size.control-h-input pack=center }
      when hover { bg=color.hover color=color.text }
      when front { bg=color.fill-active color=color.text }
      when focus-visible { stroke=color.focus-ring stroke-w=1 stroke-align=inside }
      text name style=text.label nowrap ellipsis inert
    }
  }
}

// One tool. `name` is what it is called and `said` what its hint adds (the name typed at the
// command line, the shortcut, or why it is blocked); `face` is the word drawn under the glyph.
// `slim` is the one-row ribbon's icon key. `off` is a tool the engine will not run now: it keeps
// its place and the keyboard still reaches it, so its hint can say why. `on` is the tool whose
// command is running. The room between two tools of a group is before each one but the group's
// first (`lead`), and more of it in the one-row ribbon under a finger (`wide`).
def RibbonTool(name="", face="", said="", glyph="", slim=false, off=false, on=false, lead=true, wide=false) export {
  row {
    when lead { pad-l=space.g2 }
    when wide { pad-l=space.g6 }
    when !lead { pad-l=0 }
    col h=ribbon.tool min-w=ribbon.tool-min pad=space.g4,space.g6,space.g3,space.g6 gap=space.g3 align=center \
        radius=radius.small color=color.text role=button label=name desc=said \
        act=tool {
      when slim { w=size.control-h-input h=size.control-h-input min-w=size.control-h-input pad=0 gap=0 pack=center radius=radius.round color=color.icon }
      when on { bg=color.hover color=color.text }
      when hover { bg=color.hover color=color.text }
      when pressed { bg=color.fill-active color=color.text }
      when off { bg=none color=color.text-disabled }
      when focus-visible { stroke=color.focus-ring stroke-w=1 stroke-align=inside }
      icon glyph size=size.icon-size-lg inert
      when !slim { text face style=text.chip leading=ribbon.leading nowrap inert }
    }
  }
}

// One group of the band: the hairline before it (every group but the first drawn), its tools in
// a row, and its caption under them. `cap` is the widest the caption may be: a group drawn in
// part keeps its caption under the tools that show. `slim` is the one-row ribbon's group (no
// caption, a short hairline).
def RibbonGroup(name="", lead=false, slim=false, cap=100000, tools=list(RibbonTool)) export {
  row h=fill align=center {
    row h=fill align=center {
      when lead {
        pad=0,space.g6
        rect w=size.hairline h=ribbon.rule bg=color.border {
          when slim { h=size.icon-size-lg }
        }
      }
      when slim { pad=0,space.g4 }
      when !lead { pad=0 }
    }
    col h=fill pad=space.g2,0,space.g3,0 role=group label=name {
      when slim { pad=0 pack=center }
      row {
        each tools
      }
      when !slim {
        spacer
        row w=fill max-w=cap pack=center clip {
          text name style=text.chip leading=ribbon.leading color=color.text-faint nowrap ellipsis
        }
      }
    }
  }
}

params {
  // The window is as narrow as a phone: one row, no tab row.
  compact bool = false
  // The band is not folded away, and what the fold key would do.
  open bool = true
  fold_said text = "Hide the tools"
  // The band is drawn: it is not folded, or the window is compact (which has nothing to fold).
  band bool = true
  // The tool bar's name: the tab in front's tools.
  bar_name text = "Tools"
  // The band is the panel of the tab in front (not in the one-row ribbon, which has no tabs).
  panel text = ""
  tabs list(RibbonTabKey) = []
  // The groups of the tab in front, with the tools that fit; the rest are the overflow menu's.
  groups list(RibbonGroup) = []
  // Some tools do not fit: the key that lists them is drawn, and its menu is open.
  more bool = false
  more_open bool = false
  // The width of the tab's select in the one-row ribbon (the host measures the component).
  pick_w num = 0
}

col #ribbon w=fill bg=color.chrome {
  // The tab row. (A `when`'s children come after the node's own, so each part that comes and
  // goes has a box of its own at its place.)
  col #headbox w=fill {
    when !compact {
      row #head w=fill min-h=size.control-h-button pad=0,space.g6 gap=space.g8 align=center {
        row #tabs w=fill align=center clip role=tablist label="Tools" {
          each param.tabs
        }
        row #fold w=size.control-h-input h=size.control-h-input radius=radius.round align=center pack=center \
            color=color.icon role=button label="Tool band" desc=param.fold_said expanded=param.open \
            act=fold {
          when hover { bg=color.hover color=color.text }
          when pressed { bg=color.fill-active color=color.text scale=ribbon.press }
          when focus-visible { stroke=color.focus-ring stroke-w=1 stroke-align=inside }
          // The chevron points where the band will go: up to fold it away, down to bring it back.
          icon key-fold size=size.icon-size-md inert {
            when !open { rotate=180 }
          }
        }
      }
    }
  }
  col #bandbox w=fill {
    when band {
      rect #seam w=fill h=size.hairline bg=color.border-soft {
        when compact { max-h=0 }
      }
      row #band w=fill h=ribbon.band pad=0,space.g6 align=center {
        when compact { h=size.control-h-button gap=space.g6 }
        when !compact { role=tabpanel label=param.panel }
        row #pickbox h=fill align=center {
          when compact {
            hole pick w=param.pick_w h=size.control-h-input
          }
        }
        row #bar w=fill h=fill align=center role=toolbar label=param.bar_name {
          row #tools h=fill align=center {
            each param.groups
          }
          spacer
          // The room before the key is the key's own, so a band whose tools all fit gives none up.
          row #morebox h=fill align=center {
            when compact { pad-l=space.g2 }
            when !compact { pad-l=space.g4 }
            when !more { pad-l=0 }
            when more {
              row #more w=size.control-h-input h=size.control-h-input radius=radius.round align=center pack=center \
                  color=color.icon role=button label="More tools" expanded=param.more_open \
                  act=more {
                when hover { bg=color.hover color=color.text }
                when pressed { bg=color.fill-active color=color.text scale=ribbon.press }
                when focus-visible { stroke=color.focus-ring stroke-w=1 stroke-align=inside }
                icon key-more size=size.icon-size-md inert
              }
            }
          }
        }
      }
    }
  }
  rect #edge w=fill h=size.hairline bg=color.border
}
