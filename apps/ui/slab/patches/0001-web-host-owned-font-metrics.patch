+   /**
+    * Register a metrics-only runtime face: the kernel measures with `metrics`
+    * and the host paints with `cssFamily`, a serialized CSS `font-family`
+    * value it already owns (the page's system UI stack, say). No font bytes
+    * cross the boundary: nothing is fetched, parsed or added to
+    * `document.fonts`. Registering the same family and weight again replaces
+    * the metrics on every mounted element.
+    */
+   static registerFontMetrics(name: string, metrics: FontMetrics, cssFamily: string): boolean {
+      if (!(metrics.upem > 0) || cssFamily === '') return false;
+      if (metrics.cps.length !== metrics.advs.length || metrics.cps.length !== metrics.gids.length)
+         return false;
+      const key = `${fontKey(name)}\u0000${metrics.weight}`;
+      fontSeq++;
+      const face: RegisteredFace = {
+         family: name,
+         bytes: new Uint8Array(0),
+         metrics,
+         cssFamily,
+         seq: fontSeq,
+      };
