// The application's outer layout: the title bar, the ribbon, a row of three panes (sidebar |
// editor | assistant) with draggable seams, and the status bar. Every region's content is a
// hole the host fills with the interface's existing SolidJS component (src/slab/SlabShell.tsx);
// this document decides where each one goes, how big it is, and whether it shows.
//
// The host's inputs are the shell's own switches (the same signals the standard shell reads),
// the window's width class, and the natural height of each bar.
import "gen/tokens.slab"

tokens {
  // The widths at which the workspace folds (styles.css: 900 and 560). A `when w<N` reads the
  // constraint of the node it is on, and a pane's is its own width, so the host compares the
  // window with these (read back through getToken) and sets `narrow` and `compact`.
  bp { narrow 900; compact 560 }
  // The panes' first widths and their limits. `seam` is the strip at a side pane's inner edge
  // that takes the pointer for the divider (a hole covers the rest of the seam).
  pane {
    side 252; side-min 180; side-max 560
    chat 340; chat-min 280; chat-max 720
    editor 848; editor-min 240
    seam 4; sash 8; open 100000
  }
}

params {
  sidebar   bool = true
  assistant bool = false
  toolbar   bool = true
  cmdline   bool = true
  statusbar bool = true
  // The window is at most bp.narrow / bp.compact wide.
  narrow    bool = false
  compact   bool = false
  // What each bar's content measures. (A hole sized `hug` never shrinks at this commit: the
  // driver reports the hole's scroll height, which is at least the hole's own height.)
  top_h      num = 0
  ribbon_h   num = 0
  recovery_h num = 0
  tabs_h     num = 0
  cmd_h      num = 0
  status_h   num = 0
  bench_h    num = 0
}

col #shell w=fill h=fill bg=color.chrome {
  hole topbar w=fill h=param.top_h
  col w=fill clip {
    when !toolbar { max-h=0 }
    hole ribbon w=fill h=param.ribbon_h
  }
  row #work w=fill h=fill splits split-w=pane.sash split-fg=color.accent resize=panes_resized {
    // The sidebar: closed by its switch; in a narrow window it steps aside while the assistant
    // is open. (Last patch wins: narrow hides, a closed assistant shows again, the switch hides.)
    row #side w=pane.side min-w=pane.side-min max-w=pane.side-max bg=color.panel clip {
      when narrow { min-w=0 max-w=0 }
      when !assistant { min-w=pane.side-min max-w=pane.side-max }
      when !sidebar { min-w=0 max-w=0 }
      col w=fill h=fill {
        hole rail w=fill h=fill
        // The host caps bench_h at two fifths of the rail: a clamp takes no percentage.
        hole bench w=fill h=param.bench_h scroll
      }
      rect w=pane.seam h=fill stroke=color.border stroke-sides=r stroke-align=inside {
        // Alone in a compact window the pane has no neighbour and no divider.
        when compact { max-w=0 }
      }
    }
    // The editor: in a compact window one part has the workspace, and it is the editor only
    // when neither side part is open.
    col #editor w=pane.editor min-w=pane.editor-min {
      when assistant { min-w=0 max-w=0 }
      when sidebar { min-w=0 max-w=0 }
      when !compact { min-w=pane.editor-min max-w=pane.open }
      hole recovery w=fill h=param.recovery_h
      hole tabs w=fill h=param.tabs_h
      hole stage w=fill h=fill
      col w=fill clip {
        when !cmdline { max-h=0 }
        hole cmdline w=fill h=param.cmd_h
      }
    }
    row #chat w=pane.chat min-w=pane.chat-min max-w=pane.chat-max bg=color.panel clip {
      when !assistant { min-w=0 max-w=0 }
      rect w=pane.seam h=fill stroke=color.border stroke-sides=l stroke-align=inside {
        when compact { max-w=0 }
      }
      hole assistant w=fill h=fill
    }
  }
  col w=fill clip {
    when !statusbar { max-h=0 }
    hole status w=fill h=param.status_h
  }
}
