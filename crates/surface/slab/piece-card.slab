// The piece card: what an agent driving CADCraft is shown about the open drawing's piece.
// Every figure is a param or a list row the host fills from the engine's own replies
// (`piece {query: true}` and `techsheet {}`); nothing is worked out here.
import "tokens.slab"

// One of the piece's checks: the verdict word, what was checked, and what the engine said.
def Check(name="", verdict="", message="", ok=false) export {
  row w=fill gap=12 pad=7,0 align=start {
    row w=44 h=hug pad=3,0 radius=3 pack=center bg=color.badSoft {
      when ok { bg=color.okSoft }
      text verdict style=text.tag color=color.bad nowrap {
        when ok { color=color.ok }
      }
    }
    text name w=84 style=text.strong color=color.ink nowrap ellipsis
    text message w=fill style=text.body color=color.dim
  }
}

// One line of the stone table: cut and size, pieces, carats each and in all.
def Stone(what="", pcs="", each_ct="", ct="") export {
  row w=fill gap=12 pad=5,0 align=center {
    text what w=fill style=text.body color=color.ink nowrap ellipsis
    text pcs w=48 style=text.num color=color.ink align-text=end nowrap
    text each_ct w=72 style=text.num color=color.dim align-text=end nowrap
    text ct w=72 style=text.num color=color.ink align-text=end nowrap
  }
}

// One line of the cost: what is priced, how much of it, at what rate, and the amount.
def Cost(what="", qty="", rate="", amount="") export {
  row w=fill gap=12 pad=5,0 align=center {
    text what w=fill style=text.body color=color.ink nowrap ellipsis
    text qty w=84 style=text.num color=color.dim align-text=end nowrap
    text rate w=84 style=text.num color=color.dim align-text=end nowrap
    text amount w=96 style=text.num color=color.ink align-text=end nowrap
  }
}

// A headline figure with its caption above and a note below.
def Figure(caption, value, note) {
  col w=fill gap=4 pad=12,14 radius=4 bg=color.raised {
    text caption style=text.eyebrow color=color.faint nowrap
    text value style=text.figure color=color.ink nowrap ellipsis
    text note style=text.small color=color.dim
  }
}

params {
  drawing     text = ""
  title       text = "No piece in this drawing"
  subtitle    text = ""
  size_a      text = "—"
  size_b      text = ""
  metal       text = "—"
  metal_note  text = ""
  stone_count text = "0"
  stone_note  text = ""
  verdict     text = ""
  all_ok      bool = true
  has_piece   bool = false
  has_stones  bool = false
  has_cost    bool = false
  cost_total  text = ""
  cost_figure text = ""
  cost_unit   text = ""
  cost_note   text = ""
  stones_more text = ""
  checks      list(Check) = []
  stones      list(Stone) = []
  costs       list(Cost)  = []
}

col w=fill bg=color.page pad=16 {
  // Slab at the pinned commit builds its font tables from weights written as literals only; a
  // weight that arrives through a `style=` token bundle falls back to the nearest table. These
  // never-active patches name the weights the bundles use, so each gets its table.
  when facesemi { weight=600 }
  when facebold { weight=700 }

  col w=fill bg=color.panel stroke=color.line stroke-w=1 radius=6 pad=24 gap=20 {

    // Who and what.
    row w=fill gap=16 align=start {
      col w=fill gap=6 {
        text param.drawing style=text.eyebrow color=color.faint nowrap ellipsis
        text param.title style=text.title color=color.ink
        text param.subtitle style=text.body color=color.dim
      }
      when has_piece {
        row w=hug h=hug pad=5,10 radius=999 bg=color.badSoft align=center gap=6 {
          when all_ok { bg=color.okSoft }
          rect w=6 h=6 radius=999 bg=color.bad {
            when all_ok { bg=color.ok }
          }
          text param.verdict style=text.tag color=color.bad nowrap {
            when all_ok { color=color.ok }
          }
        }
      }
    }

    // The three figures a jeweller asks for first.
    row w=fill gap=12 {
      Figure caption="SIZE" value=param.size_a note=param.size_b
      Figure caption="METAL" value=param.metal note=param.metal_note
      Figure caption="STONES" value=param.stone_count note=param.stone_note
      when has_cost {
        Figure caption="COST" value=param.cost_figure note=param.cost_unit
      }
    }

    // The checks, one row each.
    when has_piece {
      col w=fill gap=0 {
        text "CHECKS" style=text.head color=color.faint
        rect h=8
        rect h=1 bg=color.hair
        each param.checks
      }
    }
    when !has_piece {
      row w=fill pad=12,14 radius=4 bg=color.raised {
        text "No parametric piece here, so there are no checks to show. Build one with the PIECE command." style=text.body color=color.dim w=fill
      }
    }

    // The stones on the bench sheet.
    when has_stones {
      col w=fill gap=0 {
        row w=fill gap=12 pad=0,0,8,0 {
          text "STONES" w=fill style=text.head color=color.faint nowrap
          text "PCS" w=48 style=text.head color=color.faint align-text=end nowrap
          text "CT EACH" w=72 style=text.head color=color.faint align-text=end nowrap
          text "CT" w=72 style=text.head color=color.faint align-text=end nowrap
        }
        rect h=1 bg=color.hair
        each param.stones
        text param.stones_more style=text.small color=color.faint
      }
    }

    // The cost, when the drawing has a price book.
    when has_cost {
      col w=fill gap=0 {
        row w=fill gap=12 pad=0,0,8,0 {
          text "COST" w=fill style=text.head color=color.faint nowrap
          text "QTY" w=84 style=text.head color=color.faint align-text=end nowrap
          text "RATE" w=84 style=text.head color=color.faint align-text=end nowrap
          text "AMOUNT" w=96 style=text.head color=color.faint align-text=end nowrap
        }
        rect h=1 bg=color.hair
        each param.costs
        rect h=1 bg=color.hair
        row w=fill gap=12 pad=8,0,0,0 align=center {
          text "Total" w=fill style=text.strong color=color.ink
          text param.cost_total style=text.num weight=700 color=color.ink align-text=end nowrap
        }
        rect h=6
        text param.cost_note style=text.small color=color.faint
      }
    }
  }
}
